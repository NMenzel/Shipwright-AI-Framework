# TypeSafe AI API key for the Jev PR triage page (/jev-triage).
# Server-only: never prefix with NEXT_PUBLIC_. Get a key from the TypeSafe Console.
# Leave empty to keep the page in its disabled state.
TYPESAFE_API_KEY=

# Optional overrides read by @typesafe-ai/sdk.
# TYPESAFE_DEFAULT_MODEL=jev-latest
# TYPESAFE_LOG_LEVEL=warn
